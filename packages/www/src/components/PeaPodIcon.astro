---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<!--
	A loosely hand-drawn, split-open pea pod, angled like a pod plucked from the vine: an
	imperfect outline (traced twice, the second pass faint and offset, to mimic an uneven pencil
	line) with five peas nestled in the pod's lighter interior, a front lip folding over their
	lower half for depth, and a pair of curled leaves capping the tip in place of a stem. Colored
	to match the site's green palette rather than inheriting `currentColor`, since it reads as a
	small illustration rather than a UI glyph.
-->
<svg
	class={className}
	viewBox="-7 -33 134 132"
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<g transform="rotate(-32 65 65)">
		<path
			d="M8,58 C13,40 32,28 58,26 C86,24 108,32 118,50"
			stroke="#1f4525"
			stroke-width="1.3"
			opacity="0.3"
		></path>
		<path
			d="M6,58 C10,38 32,24 58,22 C84,20 106,26 120,44
			   C126,52 124,62 116,68 C98,80 70,84 46,80 C22,76 8,70 6,58 Z"
			fill="#3c7d46"
			stroke="#1f4525"
			stroke-width="2.5"
		></path>
		<path
			d="M13,53 C18,38 36,29 58,28 C82,27 100,32 111,45
			   C99,38 80,34 58,35 C38,36 22,42 13,53 Z"
			fill="#74a35c"
			opacity="0.9"
		></path>
		<g stroke="#1f4525" stroke-width="1.4">
			<circle cx="26" cy="57" r="10" fill="#9dc178"></circle>
			<circle cx="45" cy="49" r="10.5" fill="#9dc178"></circle>
			<circle cx="65" cy="44" r="11" fill="#9dc178"></circle>
			<circle cx="85" cy="46" r="10.5" fill="#9dc178"></circle>
			<circle cx="103" cy="52" r="10" fill="#9dc178"></circle>
		</g>
		<g fill="#c9dfa0">
			<circle cx="22" cy="53" r="3.1"></circle>
			<circle cx="41" cy="45" r="3.3"></circle>
			<circle cx="61" cy="40" r="3.5"></circle>
			<circle cx="81" cy="42" r="3.3"></circle>
			<circle cx="99" cy="48" r="3.1"></circle>
		</g>
		<path
			d="M8,58 C18,72 36,79 58,80 C80,81 100,76 118,58
			   C112,74 88,84 58,83 C34,82 14,74 8,58 Z"
			fill="#2e6537"
			stroke="#1f4525"
			stroke-width="2"
		></path>
		<path
			d="M117,48 Q137,34 140,10 Q120,24 117,48 Z"
			fill="#4f8a4a"
			stroke="#1f4525"
			stroke-width="1.75"
		></path>
		<path
			d="M115,52 Q137,53 152,38 Q130,37 115,52 Z"
			fill="#63995a"
			stroke="#1f4525"
			stroke-width="1.75"
		></path>
	</g>
</svg>
