---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Catering Services" description="Catering for gatherings big and small with Perch Kitchen.">
	<section class="hero">
		<div class="wrap">
			<h1>Catering for gatherings big and small</h1>
			<!-- TODO: replace with real intro copy -->
			<p class="tagline">
				From an intimate dinner party to a full event, I bring seasonal, Mediterranean-inspired
				food to your table.
			</p>
		</div>
	</section>

	<section class="wrap prose">
		<h2>How it works</h2>
		<!-- TODO: confirm actual booking process -->
		<ol>
			<li><strong>Inquire</strong> — tell me about your event, guest count, and date.</li>
			<li><strong>Menu planning &amp; tasting</strong> — we'll shape a menu around your taste and occasion.</li>
			<li><strong>Event day</strong> — I handle the shopping, cooking, and setup, so you don't have to.</li>
		</ol>

		<h2>Types of events</h2>
		<!-- TODO: replace with real service offerings -->
		<ul>
			<li>Dinner parties</li>
			<li>Corporate events</li>
			<li>Weddings and celebrations</li>
			<li>Weekly meal prep</li>
		</ul>

		<h2>Pricing</h2>
		<!-- TODO: add real pricing guidance or ranges -->
		<p>
			Pricing depends on guest count, menu, and season — reach out for a custom quote.
		</p>

		<p>
			<a href="/contact">Get in touch</a> to start planning your event.
		</p>
	</section>
</Layout>

<style>
	.hero {
		background: var(--color-tint);
		border-bottom: 1px solid var(--color-border);
		padding-block: 4rem;
		text-align: center;
	}

	.hero h1 {
		font-size: 2.5rem;
		margin: 0 0 0.75rem;
	}

	.tagline {
		font-size: 1.15rem;
		color: var(--color-text-muted);
		margin: 0;
		max-width: 34rem;
		margin-inline: auto;
	}

	.prose {
		padding-block: 3rem;
	}

	.prose h2 {
		margin-top: 2.5rem;
	}

	.prose h2:first-child {
		margin-top: 0;
	}
</style>
