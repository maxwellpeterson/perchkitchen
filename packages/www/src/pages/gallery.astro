---
// To add real photos: drop image files into src/assets/gallery/ and remove the placeholder
// .svg files (gallery-01.svg etc.) — this carousel picks up any file in that folder
// automatically, no code changes needed.
//
// Rendered as plain <img> rather than astro:assets' <Image> — the Cloudflare adapter's image
// service can't process SVG sources, so this keeps the placeholders working now and requires
// no change when real .jpg/.png photos replace them later.
import Layout from '../layouts/Layout.astro';
import ChevronLeftIcon from '../components/ChevronLeftIcon.astro';
import ChevronRightIcon from '../components/ChevronRightIcon.astro';

const galleryImages = Object.values(
	import.meta.glob('../assets/gallery/*.{jpg,jpeg,png,svg}', { eager: true })
) as { default: ImageMetadata }[];
---

<Layout title="Photo Gallery" description="A look at Perch Kitchen's food, table settings, and events.">
	<section class="wrap-wide intro-section">
		<h1>Photo Gallery</h1>
		<p class="intro">A look at the food, the table, and the evenings we've cooked for.</p>
	</section>

	<section class="wrap-wide">
		<div class="carousel" role="group" aria-roledescription="carousel" aria-label="Photo gallery">
			<button type="button" class="carousel-btn prev" aria-label="Previous photo">
				<ChevronLeftIcon />
			</button>
			<div class="carousel-track">
				{galleryImages.map((photo, i) => (
					<button
						type="button"
						class="carousel-slide"
						data-index={i}
						aria-label={`Show photo ${i + 1} of ${galleryImages.length}`}
					>
						<img
							src={photo.default.src}
							width={photo.default.width}
							height={photo.default.height}
							alt=""
							draggable="false"
						/>
					</button>
				))}
			</div>
			<button type="button" class="carousel-btn next" aria-label="Next photo">
				<ChevronRightIcon />
			</button>
		</div>
		<div class="carousel-dots">
			{galleryImages.map((_, i) => (
				<button type="button" class="dot" data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
			))}
		</div>
	</section>

	<script>
		function initCarousel(carousel: HTMLElement) {
			const track = carousel.querySelector<HTMLElement>('.carousel-track');
			const slides = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-slide'));
			const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn.prev');
			const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn.next');
			const dots = Array.from(
				document.querySelectorAll<HTMLButtonElement>('.carousel-dots .dot')
			);

			if (!track || slides.length === 0) return;

			let activeIndex = 0;

			function render() {
				const count = slides.length;
				const slideWidth = slides[0].offsetWidth;
				// The CSS aspect-ratio fallback only approximates the 3:4 slide ratio (it can't
				// account for --gap), so set the carousel's height precisely once it's measurable.
				carousel.style.height = `${slideWidth / 0.75}px`;
				// Mirrors the CSS: the carousel is exactly two slide widths plus two gaps wide,
				// so the gap between slides can be derived from the track's own measured width.
				const gap = track.offsetWidth / 2 - slideWidth;

				slides.forEach((slide, i) => {
					const distance = i - activeIndex;
					const abs = Math.abs(distance);
					const x = distance * (slideWidth + gap);
					const opacity = abs === 0 ? 1 : abs === 1 ? 0.6 : 0;

					slide.style.setProperty('--tx', `${x}px`);
					slide.style.opacity = String(opacity);
					slide.style.filter = abs === 0 ? 'none' : 'grayscale(1)';
					slide.style.zIndex = String(count - abs);
					slide.setAttribute('aria-current', abs === 0 ? 'true' : 'false');
					slide.tabIndex = abs === 0 ? 0 : -1;
					slide.style.pointerEvents = abs <= 1 ? 'auto' : 'none';
				});

				dots.forEach((dot, i) => dot.classList.toggle('is-active', i === activeIndex));

				if (prevBtn) prevBtn.disabled = activeIndex === 0;
				if (nextBtn) nextBtn.disabled = activeIndex === count - 1;
			}

			function goTo(index: number) {
				const count = slides.length;
				activeIndex = Math.max(0, Math.min(count - 1, index));
				render();
			}

			prevBtn?.addEventListener('click', () => goTo(activeIndex - 1));
			nextBtn?.addEventListener('click', () => goTo(activeIndex + 1));
			slides.forEach((slide, i) => slide.addEventListener('click', () => goTo(i)));
			dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

			carousel.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') goTo(activeIndex - 1);
				if (e.key === 'ArrowRight') goTo(activeIndex + 1);
			});

			let touchStartX: number | null = null;
			track.addEventListener(
				'touchstart',
				(e) => {
					touchStartX = e.touches[0].clientX;
				},
				{ passive: true }
			);
			track.addEventListener(
				'touchend',
				(e) => {
					if (touchStartX === null) return;
					const dx = e.changedTouches[0].clientX - touchStartX;
					if (Math.abs(dx) > 40) goTo(activeIndex + (dx < 0 ? 1 : -1));
					touchStartX = null;
				},
				{ passive: true }
			);

			window.addEventListener('resize', render);
			render();
		}

		document
			.querySelectorAll<HTMLElement>('.carousel')
			.forEach((carousel) => initCarousel(carousel));
	</script>
</Layout>

<style>
	.intro-section {
		padding-block: 3rem 0;
	}

	.intro {
		color: var(--color-text-muted);
		margin-top: -0.5rem;
	}

	.wrap-wide:last-of-type {
		padding-block: 2rem 3rem;
	}

	.carousel {
		/* The carousel bleeds past the section's own padding so it spans the same full width as
		   the page content above it. The focused slide is centered in it, and the JS below shifts
		   each neighbor over by one slide-width plus --gap, leaving a --gap-wide gap before the
		   neighbor's peek and clipping the rest at the container edge. For that peek to be exactly
		   half a slide wide (matching the old fixed-width design), slide-w must be W/2 - gap, not
		   W/2 - gap/2 — halving it here would look right but under-report the real gap to the JS
		   by half. Height can't be derived the same way in pure CSS — a % in --slide-w means
		   something different once it's substituted into the height property — so aspect-ratio
		   only approximates the 3:4 slide ratio as a fallback; the script sets the exact pixel
		   height once it can measure a rendered slide. */
		--gap: 1.5rem;
		--slide-w: calc(50% - var(--gap));
		position: relative;
		width: calc(100% + 3rem);
		margin-inline: -1.5rem;
		aspect-ratio: 1.5;
		overflow: hidden;
	}

	.carousel-track {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.carousel-slide {
		position: absolute;
		top: 0;
		left: calc(50% - var(--slide-w) / 2);
		width: var(--slide-w);
		height: 100%;
		margin: 0;
		padding: 0;
		border: none;
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--color-tint);
		cursor: pointer;
		transform: translateX(var(--tx, 0px));
		transition:
			transform 0.5s ease,
			opacity 0.5s ease,
			filter 0.5s ease;
	}

	.carousel-slide[aria-current='true'] {
		cursor: default;
	}

	.carousel-slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		pointer-events: none;
	}

	.carousel-btn {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: none;
		background: none;
		padding: 0;
		color: var(--color-surface);
		filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.45));
		cursor: pointer;
		transition:
			color 0.2s ease,
			opacity 0.2s ease;
	}

	.carousel-btn :global(svg) {
		width: 1.75rem;
		height: 1.75rem;
	}

	.carousel-btn:hover:not(:disabled) {
		color: var(--color-tint);
	}

	.carousel-btn:disabled {
		opacity: 0;
		pointer-events: none;
	}

	.carousel-btn.prev {
		left: 0.25rem;
	}

	.carousel-btn.next {
		right: 0.25rem;
	}

	.carousel-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.carousel-dots .dot {
		width: 0.5rem;
		height: 0.5rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-border);
		cursor: pointer;
	}

	.carousel-dots .dot.is-active {
		width: 1.5rem;
		border-radius: 999px;
		background: var(--color-accent-dark);
		transition:
			width 0.3s ease,
			background 0.3s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-slide,
		.carousel-dots .dot {
			transition: none;
		}
	}
</style>
